#!/usr/bin/env bash

# =============================================================================
# DEEP PIPELINE CONFIGURATION FILE
# =============================================================================
# For detailed guidance on each parameter, see the DEEP wiki:
# https://github.com/MRCIEU/DEEP_mqtls/wiki/Install-and-set-up
# =============================================================================


# =============================================================================
# SECTION A: ANALYST & STUDY DETAILS
# =============================================================================

# Study name: alphanumeric only, underscores allowed, no spaces
# Example: study_name="ABC or ABC_child"
study_name=""

# Your name
analyst_name=""

# Your email address
analyst_email=""

# SFTP username provided by the DEEP developers
# Contact Josine.Min@bristol.ac.uk or Hannah.Elliott@bristol.ac.uk to obtain this
sftp_username=""

# Path to your SSH private key for authenticating with the DEEP SFTP server
# This is typically ~/.ssh/id_rsa or ~/.ssh/id_ed25519
# Instructions for setting up SSH keys:
# https://github.com/MRCIEU/DEEP_mqtls/wiki/SSH-Key-Setup
key="~/.ssh/id_ed25519"


# =============================================================================
# SECTION B: METHYLATION DATA
# =============================================================================

# Methylation array platform used to generate your data
# Options: 450k | epic | epic2   (case-sensitive)
methylation_array="epic"

# Tissue type from which DNA methylation was measured
# Options: blood | PBMC | PBL | cord | saliva | buccal (case-sensitive)
tissue="blood"

# Were the methylation measurements obtained from sorted (purified) cell types,
# rather than bulk (mixed) tissue?
# Example: "yes" if you have methylation from CD4+ T cells, monocytes, etc.
# Options: yes | no
sorted_methylation="no"

# File path to raw IDAT files (leave blank if not available)
# IDAT files are the raw output from the Illumina methylation array scanner
idat_directory=""

# Optional: full path to an Illumina-format CSV sample sheet.
# If set, meffil.read.samplesheet() will be used instead of meffil.create.samplesheet().
# The CSV must contain: Sample_Name, Sex (M/F/NA), Sentrix_ID (or Slide_ID), Sentrix_Position (or Array_ID)
# Example: samplesheet_path="/user/path/to/your/samplesheet.csv"
# - If your CSV is in the same directory as your IDAT files, leave idat_directory blank.
# - If your CSV and IDAT files are in different directories, set both samplesheet_path AND idat_directory.
# Leave blank to auto-generate samplesheet from IDAT files.
samplesheet_path=""


# =============================================================================
# SECTION C: GENOTYPE DATA
# =============================================================================

# Genome build of your GENOTYPE reference data
# Options: 37 (= GRCh37 / hg19) | 38 (= GRCh38 / hg38)
# If unsure, check the manifest file used for your array
genome_build="38"

# Ancestry of your study participants
# This is used to compare allele frequencies against the reference panel (TopMed)
# Options: EUR | AFR | AMR | EAS | SAS | None
# Use "None" if ancestry is mixed or does not clearly match one population
ancestry="AFR"

# Reference panel used for genotype imputation
# Options: 1000g | 1000g + h3africa | topmed | 1000g + caapa
# Use the panel that matches what was used during your imputation step
# TopMed is recommended for diverse ancestries
reference="topmed"

# Are the samples related? (e.g. family data, twin data)
# Options: yes | no
# Use "no" if you are unsure whether cryptic relatedness exists
related="no"


# =============================================================================
# SECTION D: PHENOTYPE DATA
# =============================================================================
# Study-specific covariates for EWAS adjustment
# These are variables specific to your study design that are not universally
# collected (e.g. case/control status, sample processing batch, array type).
# Do NOT include standard covariates already handled by the pipeline (age, sex, cell counts).
# Variable names must match column headers in your covariates file exactly,
# and must end in _factor (categorical) or _numeric (continuous).
# Separate multiple variables with a single space.
# Example: study_specific_vars="CaseControl_factor Plate_factor"
# Note on batch variables: only include if you have evidence of a batch effect
# Avoid using slide (too many categories); use plate instead.
# https://github.com/MRCIEU/DEEP_mqtls/wiki/Phenotype-data
study_specific_vars=""

# Age range of the study participants
# Options: <18 | >18 | all
# Use "all" if your cohort spans both adults and children, or if a small
# minority fall outside the main age group (e.g. 95% adults with a few <18)
age=">18"

# Cellcounts: path to file containing directly measured cell type proportions
# These will be compared against pipeline-predicted cell type proportions
# Set to NULL if you do not have directly measured cellcounts
measured_cellcounts=""

# =============================================================================
# SECTION E: SYSTEM PATHS AND INPUT DATA FILES
# =============================================================================

# Full path to your project home directory
# This should be the parent folder containing your input_data/ subdirectory
# Example: home_directory="/home/username/projects/DEEP"
home_directory=""

# Full path to the cloned DEEP_mqtls GitHub repository
# Example: scripts_directory="/home/username/projects/DEEP/DEEP_mqtls"
scripts_directory=""

# Paths to R/Python executables:
# - If you use conda/mamba (`deep_env`) OR your HPC provides tools via `module load`,
#   leave all three fields empty:
#   R_directory="", Python_directory="", Python2_directory=""
# - Only set these paths if you are not using conda/mamba or module load.
# - If you set one path manually, set all three:
#   R_directory, Python_directory, and Python2_directory.
R_directory=""
Python_directory=""   # Python 3.9 or later (required for Hail)
Python2_directory=""  # Python 2.7 (required for HASE)

# Input data file paths
# These default to the expected locations within your home_directory/input_data/ folder
betas="${home_directory}/input_data/data.RData"
bfile_raw="${home_directory}/input_data/data"
vcf_dir="${home_directory}/input_data/topmed_vcfs/"
covariates="${home_directory}/input_data/covariates.txt"
phenotypes="${home_directory}/input_data/phenotypes.txt"   # Set to NULL if no phenotypes available
quality_scores="${home_directory}/input_data/data.info"    # File with columns: SNP, MAF, quality score


# =============================================================================
# SECTION F: COMPUTING RESOURCES AND FILTERING PARAMETERS
# =============================================================================
# The defaults below are suitable for most datasets.
# Only modify if you have specific requirements or are running on a resource-limited system.
# See the DEEP wiki for guidance: https://github.com/MRCIEU/DEEP_mqtls/wiki

# Memory allocation in GB
# If running on an HPC (eg. using SLURM), set this to match what you request in your job submission script
mem="20"

# Number of CPU threads to use (parallelisation)
nthreads="16"

# Chunk size for methylation data during normalisation
# Increase if you have memory issues; decrease for faster parallel runs on large datasets
meth_chunks="100"

# Chunk size for genetic data during mQTL analysis and cellcount GWAS
# A higher value means more parallel jobs but each job processes fewer SNPs
# meth_chunks splits CpG sites; genetic_chunks splits SNPs - these are independent
genetic_chunks="1000"

# SNP quality control thresholds
snp_hwe="1e-6"      # Hardy-Weinberg equilibrium p-value threshold
snp_maf="0.01"      # Minor allele frequency minimum
snp_miss="0.05"     # Maximum SNP missingness rate
snp_imiss="0.05"    # Maximum individual missingness rate

# Genetic relatedness matrix (GRM) parameters
rel_cutoff="0.05"       # Relatedness coefficient threshold for sample exclusion
grm_maf_cutoff="0.01"   # MAF threshold for SNPs used in GRM calculation

# Principal component analysis (PCA) parameters
n_pcs="20"      # Number of genetic PCs to compute
pca_sd="7"      # SD threshold for outlier removal in PCA

# Methylation PC parameters (used in EWAS adjustment)
n_meth_pcs="20"              # Number of methylation PCs to compute
meth_pc_cutoff="0.8"         # Variance explained threshold for selecting PCs
meth_pc_threshold="1e-7"     # P-value threshold for including methylation PCs as covariates

# MatrixEQTL soft threshold (for cis-mQTL analysis)
soft_threshold="1e-5"


# =============================================================================
# DO NOT MODIFY BELOW THIS LINE
# =============================================================================
source ${scripts_directory}/resources/parameters
